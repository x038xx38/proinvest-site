[Unit]
Description=ProInvest Django (gunicorn)
After=network.target postgresql.service redis-server.service

[Service]
User=proinvest
Group=proinvest
WorkingDirectory=/opt/proinvest/app
EnvironmentFile=/opt/proinvest/app/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/opt/proinvest/app/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8010 --workers 3 --timeout 60 \
    --access-logfile - --error-logfile -
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
