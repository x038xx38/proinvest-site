# ProInvest — {{DOMAIN}}. HTTPS-блок добавит certbot --nginx.
server {
    listen 80;
    server_name {{DOMAIN}};

    client_max_body_size 20m;

    location /static/ {
        alias /opt/proinvest/app/staticfiles/;
        expires 30d;
        access_log off;
    }

    location /media/ {
        alias /opt/proinvest/app/media/;
        expires 7d;
        access_log off;
    }

    location / {
        # Тестовый стенд закрыт паролем; убрать при запуске на боевом домене
        auth_basic "ProInvest staging";
        auth_basic_user_file /opt/proinvest/htpasswd;

        proxy_pass http://127.0.0.1:8010;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
