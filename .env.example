# Скопируйте в .env и при необходимости поправьте
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8001

DATABASE_URL=postgres://proinvest:proinvest@127.0.0.1:5433/proinvest
REDIS_URL=redis://127.0.0.1:6380/0

# Локально письма уходят в Mailpit (http://localhost:8025)
EMAIL_URL=smtp://127.0.0.1:1025
DEFAULT_FROM_EMAIL=ПроИнвест <noreply@proinvest.local>
LEADS_NOTIFY_EMAILS=manager@proinvest.local

ALLOW_INDEXING=false

# Django Debug Toolbar (требует рабочий GDAL в системе)
USE_DEBUG_TOOLBAR=false
